# Copy this file to ".env" and fill it in. Never commit the real ".env".

# Optional. When set, plans are stored in MongoDB instead of SQLite.
# Atlas: Database > Connect > Drivers, copy the string and replace <password>.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=preflight

# Optional
PORT=3000
